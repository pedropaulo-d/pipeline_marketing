# ========================
# Segurança e Credenciais
# ========================
.env
.env.bak

# ========================
# dbt
# ========================
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
logs/

# ========================
# Dados Temporários e Logs
# ========================
# Dado bruto real das APIs — nunca versionar (contas de clientes reais).
# A barra inicial ancora a regra na raiz: sem ela o padrao casava tambem
# tests/fixtures/temp_meta_raw.json e excluia a fixture sintetica em silencio.
/temp_meta_raw.json
/temp_google_raw.json
# Manifestos de extracao: acompanham os brutos e carregam janela, run_id e
# sha256. Nao tem dado de cliente, mas descrevem um artefato que nao existe
# num clone limpo — versiona-los so criaria manifesto orfao.
/temp_meta_raw.manifesto.json
/temp_google_raw.manifesto.json
# Resto de escrita atomica interrompida (arquivo vizinho antes do `os.replace`).
*.parcial
*.log

# (Opcional) Se for salvar arquivos CSV/JSON futuros de transformação
*.csv
/data/

# Excecao: os resultados do benchmark sao evidencia experimental do TCC.
!benchmark/resultados/*.csv

# Excecao: dataset SINTETICO de demonstracao do dashboard. Nao deriva de nome,
# identificador nem metrica de cliente — sai de `dashboard/gerar_dados_demo.py`
# com semente fixa. E o que mantem o repositorio demonstravel sem versionar a
# superficie de exposicao (que continua coberta por `/data/`).
!dashboard/dados_demo/*.csv

